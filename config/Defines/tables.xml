  </bean>
  <table name="Enemies" value="EnemiesRow" input="Enemies@monsters.xlsx" index="id" />
  <bean name="ItemEffectsRow">
    <var name="id" type="string" />
    <var name="kind" type="string" />
    <var name="power" type="int" />
    <var name="turnsMin" type="int" />
    <var name="turnsMax" type="int" />
    <var name="range" type="int" />
    <var name="wallDamage" type="int" />
  </bean>
  <table name="ItemEffects" value="ItemEffectsRow" input="ItemEffects@items.xlsx" index="id" />
  <bean name="ItemsRow">
