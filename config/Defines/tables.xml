<module name="">
  <bean name="SettingsRow">
    <var name="path" type="string" />
    <var name="value" type="double" />
    <var name="description" type="string" />
    <var name="unit" type="string" />
    <var name="allowedRange" type="string" />
    <var name="example" type="string" />
  </bean>
  <table name="Settings" value="SettingsRow" input="Settings@rules.xlsx" index="path" />
  <bean name="RuleProfilesRow">
    <var name="id" type="string" />
  </bean>
  <table name="RuleProfiles" value="RuleProfilesRow" input="RuleProfiles@rules.xlsx" index="id" />
  <bean name="RuleValuesRow">
    <var name="profileId" type="string#ref=RuleProfiles" />
    <var name="path" type="string" />
    <var name="value" type="double" />
    <var name="description" type="string" />
    <var name="unit" type="string" />
    <var name="allowedRange" type="string" />
    <var name="example" type="string" />
  </bean>
  <table name="RuleValues" value="RuleValuesRow" input="RuleValues@rules.xlsx" mode="list" />
  <bean name="MapProfilesRow">
    <var name="id" type="string" />
  </bean>
  <table name="MapProfiles" value="MapProfilesRow" input="MapProfiles@dungeons.xlsx" index="id" />
  <bean name="MapValuesRow">
    <var name="profileId" type="string#ref=MapProfiles" />
    <var name="path" type="string" />
