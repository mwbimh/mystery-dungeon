  <table name="EnemySpawns" value="EnemySpawnsRow" input="EnemySpawns@spawns.xlsx" mode="list" />
  <bean name="ItemGroupsRow">
    <var name="id" type="string" />
  </bean>
  <table name="ItemGroups" value="ItemGroupsRow" input="ItemGroups@spawns.xlsx" index="id" />
  <bean name="ItemSpawnsRow">
    <var name="groupId" type="string#ref=ItemGroups" />
    <var name="id" type="string#ref=Items" />
    <var name="weight" type="double" />
  </bean>
  <table name="ItemSpawns" value="ItemSpawnsRow" input="ItemSpawns@spawns.xlsx" mode="list" />
  <bean name="LocalesRow">
    <var name="id" type="string" />
    <var name="name" type="string" />
    <var name="isDefault" type="int" />
  </bean>
  <table name="Locales" value="LocalesRow" input="Locales@texts.xlsx" index="id" />
  <bean name="TextKeysRow">
    <var name="key" type="string" />
    <var name="context" type="string" />
  </bean>
  <table name="TextKeys" value="TextKeysRow" input="TextKeys@texts.xlsx" index="key" />
  <bean name="TranslationsRow">
    <var name="key" type="string#ref=TextKeys" />
    <var name="locale" type="string#ref=Locales" />
    <var name="text" type="string" />
  </bean>
  <table name="Translations" value="TranslationsRow" input="Translations@texts.xlsx" mode="list" />
</module>
